# ===== 系统与工具产物 =====
.DS_Store
__pycache__/
*.pyc
.codex/
/tmp/
logs/command-log.jsonl
# 复盘 cron 日志含持仓信号，只存本地
logs/*.log
logs/review-cron.log
reports/美团/command-log.jsonl

# 雪球爬虫登录态缓存（含 cookies，本地使用）
/tmp/xueqiu_state.json

# ===== 音视频大文件不入库 =====
# 如确需提交某个文件，用 git add -f 显式加入
*.m4a
*.mp3
*.wav
*.mp4
*.mov

# ===== 本地资料区：不打算公开的文件放这个目录，永不入库 =====
/local/

# 组合报告只存本地，不公开
reports/portfolio-latest.md

# 实盘记录/ 公开权重口径版；原始账本（含股数/金额）在 local/实盘记录-原始/（已被 /local/ 规则覆盖）

# ===== 交易账本事实源：真实规模只存本地（公开决策，不公开规模）=====
# 仓库只保留 *.example.csv 合成示例；真实账本/价格永不入库
data/portfolio/transactions.csv
data/portfolio/prices.csv
data/portfolio/*.local.*

# 数据层快照缓存（不入库：尊重数据源ToS + 避免陈旧数据）
data/cache/
data/portfolio/decisions.jsonl
data/portfolio/postmortems.jsonl
data/portfolio/*backup*.csv
data/portfolio/transactions.*.csv
data/pit_financials.jsonl
data/corporate_actions.jsonl
data/delisting.jsonl
data/lineage.jsonl

# 组合体检等含真实持仓/规模的私密报告，只存本地
reports/private/

# ===== API 密钥：永不入库 =====
config/secrets.local.json
.env
*.key

# 个人研究流水线（watchlist 状态机的真实内容，只存本地）
data/watchlist.pipeline.json

# 事实源：标的主数据 + 点时快照库（含个人研究标的池与累积数据，只存本地）
data/security_master.json
data/pit_store.json
data/candidate_pool.jsonl
data/ingest_manifest.json
