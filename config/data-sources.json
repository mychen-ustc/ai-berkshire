  "conventions": {
    "adjust": "历史序列一律用【前复权】做对比/涨幅/估值分位；总回报用后复权；快照用不复权。不得在同一分析内混用。",
    "currency": "每条记录必须标注币种（CNY/HKD/USD）；跨币种比较前先换算并注明汇率时点。",
    "unit": "每条记录标注单位（元/股、亿元、%），防止市值差一个零。",
    "point_in_time": "基本面数据必须带 available_at（首次公布时点）；回测/历史分析不得使用当时尚未公布的数据（防前视偏差）。",
    "provenance": "每条记录留存 source / source_url / fetched_at / as_of / version，标准化值与原始值均可追溯。",
    "quality_gate": "缺失、过期、跨源冲突的数据不得被静默使用——必须显式标记 warn/stale/conflict。"
  },
  "tiers": {
